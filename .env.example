# ==============================================================================
# Renewable Energy Certificate (REC) Fraud Detection & Tracking System
# Environment Configuration Template
# ==============================================================================

# Backend FastAPI Settings
PROJECT_NAME="REC Fraud Detection & Tracking System"
ENVIRONMENT="development"
VERSION="1.0.0"
DEBUG=True

# Database Configuration (PostgreSQL in production; SQLite in dev)
DATABASE_URL="sqlite:///./rec_guardian.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://rec_user:rec_secure_password@localhost:5432/rec_guardian_db"

# JWT Authentication
SECRET_KEY="replace-with-a-random-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Document Upload & Storage Directory (Off-Chain)
UPLOAD_DIR="./uploads/documents"
MAX_UPLOAD_SIZE_MB=25

# Hyperledger Fabric Gateway Integration
FABRIC_GATEWAY_URL="http://localhost:5050"
FABRIC_CHANNEL_NAME="rec-channel"
FABRIC_CHAINCODE_NAME="rec-contract"

# Frontend Next.js Public Settings
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_FABRIC_GATEWAY_URL="http://localhost:5050"

# Note: Never commit real private keys, certificates, or production passwords to source control.
